    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'net_listener'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=net_listener",
                    "--package=net_listener"
                ],
                "cwd": "${workspaceFolder}"
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"],
            "stopOnEntry": false,
            "console": "debugConsole",
            "preLaunchTask": "Build-net_listener-setCap"
        }
