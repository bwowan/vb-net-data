{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'net_visualizator'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=net_visualizator",
                    "--package=net_visualizator"
                ],
                "filter": {
                    "name": "net_visualizator",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"]
        },
        {
            "name": "Debug executable 'net_listener'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=net_listener",
                    "--package=net_listener"
                ],
                "filter": {
                    "name": "net_listener",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"],
            "preLaunchTask": "Build-net_listener-setCap"
        },
        {
            "name": "Debug executable 'net_listener' (built binary)",
            "type": "lldb",
            "request": "launch",
            "program": "/tmpu/NetData/debug/net_listener",
            "args": [],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"],
            "preLaunchTask": "Build-net_listener-setCap"
        },
        {
            "name": "Debug unit tests in library 'common'",
